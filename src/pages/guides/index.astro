---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import GuidesHomePage from '@/components/guides/GuidesHomePage.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

// Ngôn ngữ duy nhất: tiếng Việt
const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`VividKit Guides - ${t('site.title')}`}
  description={t('site.description')}
  activeTab="index"
  lang={lang}
>
  <GuidesHomePage lang={lang} />
</GuidesLayout>
