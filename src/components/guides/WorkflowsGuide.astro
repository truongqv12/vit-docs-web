---
// WorkflowsGuide - thành phần tổng hợp, chỉ hiển thị Engineer Kit
// Marketing Kit đã bị gỡ theo yêu cầu prune P3
import { engineerKitWorkflows as engineerWorkflowsEn } from '@/data/guides/workflows';
import { engineerKitWorkflows as engineerWorkflowsVi } from '@/data/vi/guides/workflows';
import { getLangFromUrl, type Language } from '@/i18n';
import WorkflowsHeaderAndVersionToggle from './workflows/workflows-header-and-version-toggle.astro';
import WorkflowsEngineerSection from './workflows/workflows-engineer-section.astro';
import WorkflowsProTipsAndNavigation from './workflows/workflows-pro-tips-and-navigation.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);

const engineerWorkflows = currentLang === 'vi' ? (engineerWorkflowsVi || engineerWorkflowsEn) : engineerWorkflowsEn;
---

<style>
  @keyframes flow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
  .flow-arrow {
    animation: flow 2s ease-in-out infinite;
  }
</style>

<div class="space-y-8 mt-6">
  <WorkflowsHeaderAndVersionToggle lang={currentLang} />

  <!-- Engineer Kit Content -->
  <div id="wf-engineer-content">
    <WorkflowsEngineerSection workflows={engineerWorkflows} lang={currentLang} />
    <WorkflowsProTipsAndNavigation lang={currentLang} />
  </div>

</div>
