---
// Header — chỉ link đến Guides sau khi bỏ landing marketing (prune P3)
import Logo from '@/components/ui/Logo.astro';
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';

interface Props {
  class?: string;
  lang?: Language;
}

const { class: className = '', lang = 'vi' } = Astro.props;

// Lấy ngôn ngữ từ URL nếu không truyền vào
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<header class="fixed top-6 left-6 right-6 z-50 transition-all duration-300" id="main-header">
  <div class="glass-card bg-white/70 dark:bg-slate-950/70 border border-white/40 dark:border-white/10 rounded-full max-w-5xl mx-auto shadow-2xl shadow-black/5 ring-1 ring-black/5 dark:ring-white/10">
    <div class="px-4 lg:px-6 py-3">
      <div class="flex items-center justify-between gap-4">
        <!-- Logo — trỏ về trang Guides -->
        <a href={translatePath('/guides')} class="flex items-center gap-3 hover:opacity-80 transition-opacity cursor-pointer shrink-0">
          <Logo size="md" />
        </a>

        <!-- Navigation trung tâm — chỉ Guides -->
        <nav class="hidden lg:flex items-center justify-center flex-1">
          <ul class="flex items-center gap-3 xl:gap-5 px-3 xl:px-4 py-1.5 rounded-full bg-white/50 dark:bg-white/5 border border-white/20 dark:border-white/5 shadow-inner">
            <li><a href={translatePath('/guides')} class="nav-link text-[10px] xl:text-xs font-semibold uppercase tracking-wide px-1.5 xl:px-2 py-1 whitespace-nowrap">{t('nav.guides')}</a></li>
          </ul>
        </nav>

        <!-- Nút bên phải: chỉ theme toggle -->
        <div class="flex items-center gap-2 lg:gap-3 shrink-0">
          <!-- Nút chuyển đổi giao diện sáng/tối -->
          <button id="theme-toggle" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer text-slate-600 dark:text-slate-300" aria-label={t('header.toggle_theme')}>
            <!-- Icon mặt trời -->
            <svg class="w-4 h-4 hidden dark:block sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <!-- Icon mặt trăng -->
            <svg class="w-4 h-4 dark:hidden moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>

          <!-- Nút mở menu mobile -->
          <button id="mobile-menu-toggle" class="lg:hidden p-2 text-slate-600 dark:text-slate-300 cursor-pointer" aria-label={currentLang === 'vi' ? 'Mở menu' : 'Open menu'}>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="hidden lg:hidden absolute top-full left-4 right-4 mt-2 glass-card rounded-2xl p-4 shadow-xl">
    <nav class="flex flex-col gap-2">
      <a href={translatePath('/guides')} class="px-4 py-3 rounded-xl hover:bg-slate-100 dark:hover:bg-white/10 text-slate-600 dark:text-slate-300 font-medium transition-colors">{t('nav.guides')}</a>
    </nav>
  </div>
</header>

<script is:inline>
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuToggle && mobileMenu) {
    mobileMenuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Đóng menu khi nhấn vào link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }

  // Highlight active nav link theo URL
  const navLinks = document.querySelectorAll('.nav-link');
  function updateActiveNav() {
    const path = window.location.pathname;
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href && path.startsWith('/guides')) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  }

  updateActiveNav();
  window.addEventListener('popstate', updateActiveNav);

  // Ẩn header khi cuộn xuống trên trang article, hiển thị khi cuộn lên
  (function() {
    const path = window.location.pathname;
    // Chỉ áp dụng cho các trang article inside-claudekit
    const isArticlePage = /\/(vi\/)?guides\/inside-claudekit\/.+/.test(path);
    if (!isArticlePage) return;

    const header = document.getElementById('main-header');
    if (!header) return;

    let lastScrollY = window.scrollY;
    let ticking = false;
    const SCROLL_THRESHOLD = 60;

    function onScroll() {
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;

      if (currentY <= SCROLL_THRESHOLD) {
        header.style.transform = '';
        header.style.opacity = '';
      } else if (delta > 5) {
        header.style.transform = 'translateY(-120%)';
        header.style.opacity = '0';
      } else if (delta < -5) {
        header.style.transform = '';
        header.style.opacity = '';
      }

      lastScrollY = currentY;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  })();
</script>
