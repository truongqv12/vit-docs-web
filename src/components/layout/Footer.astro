---
// Footer — đơn giản hóa sau prune P3, chỉ giữ link Guides hợp lệ
import Logo from '@/components/ui/Logo.astro';
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';

interface Props {
  class?: string;
  lang?: Language;
}

const { class: className = '', lang } = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<footer class={`relative z-10 w-full bg-white/80 dark:bg-slate-950/80 backdrop-blur-xl border-t border-slate-200 dark:border-white/10 ${className}`}>
  <div class="max-w-7xl mx-auto px-6 py-12 md:px-8">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <div class="mb-4">
          <Logo size="md" />
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400">{t('footer.tagline')}</p>
      </div>

      <!-- Hướng dẫn — các trang docs còn tồn tại -->
      <div>
        <h4 class="font-heading font-semibold mb-4">{t('footer.resources')}</h4>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href={translatePath('/guides')} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors cursor-pointer">{t('footer.links.guides')}</a></li>
          <li><a href={translatePath('/guides/cli')} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors cursor-pointer">{t('guides.cli.title')}</a></li>
          <li><a href={translatePath('/guides/commands')} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors cursor-pointer">{t('guides.commands.title')}</a></li>
          <li><a href={translatePath('/guides/workflows')} class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors cursor-pointer">{t('guides.workflows.title')}</a></li>
        </ul>
      </div>

      <!-- Cộng đồng -->
      <div>
        <h4 class="font-heading font-semibold mb-4">{t('footer.get_started')}</h4>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <!-- Link cộng đồng Vit — placeholder cho đến khi có URL chính thức -->
          <li><a href="#" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors cursor-pointer">{t('footer.claudekit_discord')}</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200 dark:border-slate-800/50 flex flex-col items-center gap-4 text-center text-sm text-slate-500">
      <p>{t('footer.copyright')}</p>
    </div>
  </div>
</footer>
